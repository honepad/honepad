{
  "id": "erlang",
  "name": "Erlang",
  "ext": "erl",
  "naming": "snake",
  "suites": [
    "gca"
  ],
  "ci": true,
  "adapter": "escript",
  "run": {
    "kind": "script",
    "solution": "solution.erl",
    "stub": "stub.erl",
    "tool": [
      "escript"
    ],
    "tool_error": "escript not found",
    "argv": [
      "{{tool}}",
      "{{pack}}/adapter.erl",
      "{{src}}",
      "{{class}}"
    ],
    "requires": [
      "escript"
    ]
  }
}
