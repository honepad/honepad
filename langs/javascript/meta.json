{
  "id": "javascript",
  "name": "JavaScript",
  "ext": "js",
  "naming": "camel",
  "suites": [
    "gca",
    "ica"
  ],
  "ci": true,
  "adapter": "node",
  "run": {
    "kind": "script",
    "solution": "solution.js",
    "stub": "stub.js",
    "tool": [
      "node"
    ],
    "argv": [
      "{{tool}}",
      "{{pack}}/adapter.js",
      "{{src}}",
      "{{class}}"
    ],
    "requires": [
      "node"
    ]
  }
}
