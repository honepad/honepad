{
  "id": "clojure",
  "name": "Clojure",
  "ext": "clj",
  "naming": "snake",
  "suites": [
    "gca"
  ],
  "ci": true,
  "adapter": "clojure",
  "run": {
    "kind": "script",
    "solution": "solution.clj",
    "stub": "stub.clj",
    "tool_hook": "clojure",
    "argv": [
      "{{tool}}",
      "{{pack}}/adapter.clj",
      "{{src}}",
      "{{class}}"
    ],
    "requires": [
      [
        "clojure",
        "java"
      ]
    ]
  }
}
