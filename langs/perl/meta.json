{
  "id": "perl",
  "name": "Perl",
  "ext": "pl",
  "naming": "snake",
  "suites": [
    "gca"
  ],
  "ci": true,
  "adapter": "perl",
  "run": {
    "kind": "script",
    "solution": "solution.pl",
    "stub": "stub.pl",
    "tool": [
      "perl"
    ],
    "argv": [
      "{{tool}}",
      "{{pack}}/adapter.pl",
      "{{src}}",
      "{{class}}"
    ],
    "requires": [
      "perl"
    ]
  }
}
