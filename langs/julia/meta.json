{
  "id": "julia",
  "name": "Julia",
  "ext": "jl",
  "naming": "snake",
  "suites": [
    "gca"
  ],
  "ci": true,
  "adapter": "julia",
  "run": {
    "kind": "script",
    "solution": "solution.jl",
    "stub": "stub.jl",
    "tool": [
      "julia"
    ],
    "tool_error": "julia not found",
    "argv": [
      "{{tool}}",
      "{{pack}}/adapter.jl",
      "{{src}}",
      "{{class}}"
    ],
    "requires": [
      "julia"
    ]
  }
}
