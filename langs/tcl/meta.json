{
  "id": "tcl",
  "name": "Tcl",
  "ext": "tcl",
  "naming": "snake",
  "suites": [
    "gca"
  ],
  "ci": true,
  "adapter": "tclsh",
  "run": {
    "kind": "script",
    "solution": "solution.tcl",
    "stub": "stub.tcl",
    "tool": [
      "tclsh",
      "tclsh8.6",
      "tclsh8.7"
    ],
    "tool_error": "tclsh not found",
    "argv": [
      "{{tool}}",
      "{{pack}}/adapter.tcl",
      "{{src}}",
      "{{class}}"
    ],
    "requires": [
      [
        "tclsh",
        "tclsh8.6",
        "tclsh8.7"
      ]
    ]
  }
}
