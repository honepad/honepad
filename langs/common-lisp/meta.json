{
  "id": "common-lisp",
  "name": "Common Lisp",
  "ext": "lisp",
  "naming": "snake",
  "suites": [
    "gca"
  ],
  "ci": true,
  "adapter": "sbcl",
  "run": {
    "kind": "script",
    "solution": "solution.lisp",
    "stub": "stub.lisp",
    "tool": [
      "sbcl"
    ],
    "tool_error": "sbcl not found",
    "argv": [
      "{{tool}}",
      "--script",
      "{{pack}}/adapter.lisp",
      "{{src}}",
      "{{class}}"
    ],
    "requires": [
      "sbcl"
    ]
  }
}
