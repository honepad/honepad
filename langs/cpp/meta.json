{
  "id": "cpp",
  "name": "C++",
  "ext": "cpp",
  "naming": "camel",
  "suites": [
    "gca",
    "ica"
  ],
  "ci": true,
  "adapter": "g++",
  "run": {
    "kind": "compiled",
    "solution": "solution.cpp",
    "stub": "stub.cpp",
    "copy": {
      "adapter.cpp": "{{pack}}/adapter.cpp",
      "minijson.hpp": "{{pack}}/minijson.hpp",
      "harness.hpp": "{{pack}}/harness.hpp"
    },
    "src_as": "solution.cpp",
    "write": {
      "ctor.cpp": "#include \"harness.hpp\"\n#include \"solution.cpp\"\n\nHarness* new_target() { return new {{class}}(); }\n"
    },
    "steps": [
      {
        "tool": [
          "c++",
          "g++",
          "clang++",
          "cl"
        ],
        "tool_error": "c++ compiler not found",
        "argv_by_tool": {
          "cl": [
            "{{tool}}",
            "/nologo",
            "/EHsc",
            "/std:c++17",
            "adapter.cpp",
            "ctor.cpp",
            "solution.cpp",
            "/Fe:run.exe"
          ],
          "*": [
            "{{tool}}",
            "-std=c++17",
            "-O0",
            "adapter.cpp",
            "ctor.cpp",
            "solution.cpp",
            "-o",
            "run"
          ]
        },
        "fail": "c++ compile failed"
      }
    ],
    "argv": [
      "{{tmp}}/run",
      "{{cases}}",
      "{{report}}"
    ],
    "requires": [
      [
        "c++",
        "g++",
        "clang++",
        "cl"
      ]
    ]
  }
}
