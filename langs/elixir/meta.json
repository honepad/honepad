{
  "id": "elixir",
  "name": "Elixir",
  "ext": "ex",
  "naming": "snake",
  "suites": [
    "gca"
  ],
  "ci": true,
  "adapter": "elixir",
  "run": {
    "kind": "script",
    "solution": "solution.ex",
    "stub": "stub.ex",
    "tool": [
      "elixir"
    ],
    "tool_error": "elixir not found",
    "argv": [
      "{{tool}}",
      "{{pack}}/adapter.exs",
      "{{src}}",
      "{{class}}"
    ],
    "requires": [
      "elixir"
    ]
  }
}
