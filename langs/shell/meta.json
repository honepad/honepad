{
  "id": "shell",
  "name": "Shell",
  "ext": "sh",
  "naming": "snake",
  "suites": [
    "extra"
  ],
  "ci": true,
  "adapter": "bash",
  "run": {
    "kind": "script",
    "solution": "solution.sh",
    "stub": "stub.sh",
    "tool": [
      "bash"
    ],
    "argv": [
      "{{tool}}",
      "{{langs}}/bash/adapter.sh",
      "{{src}}",
      "{{class}}"
    ],
    "requires": [
      "bash"
    ]
  }
}
