{
  "id": "dart",
  "name": "Dart",
  "ext": "dart",
  "naming": "camel",
  "suites": [
    "gca"
  ],
  "ci": true,
  "adapter": "dart",
  "run": {
    "kind": "script",
    "solution": "solution.dart",
    "stub": "stub.dart",
    "tool": [
      "dart"
    ],
    "tool_error": "dart not found",
    "argv": [
      "{{tool}}",
      "run",
      "{{pack}}/adapter.dart",
      "{{src}}",
      "{{class}}"
    ],
    "requires": [
      "dart"
    ]
  }
}
