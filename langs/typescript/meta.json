{
  "id": "typescript",
  "name": "TypeScript",
  "ext": "ts",
  "naming": "camel",
  "suites": [
    "gca",
    "ica"
  ],
  "ci": true,
  "adapter": "node",
  "run": {
    "kind": "script",
    "solution": "solution.ts",
    "stub": "stub.ts",
    "tool": [
      "node"
    ],
    "argv": [
      "{{tool}}",
      "{{langs}}/javascript/adapter.js",
      "{{src}}",
      "{{class}}"
    ],
    "requires": [
      "node"
    ]
  }
}
