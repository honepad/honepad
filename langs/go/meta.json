{
  "id": "go",
  "name": "Go",
  "ext": "go",
  "naming": "camel",
  "suites": [
    "gca",
    "ica"
  ],
  "ci": true,
  "adapter": "go-run",
  "run": {
    "kind": "compiled",
    "solution": "solution.go",
    "stub": "stub.go",
    "copy": {
      "00_sink.go": "{{pack}}/00_sink.go",
      "adapter.go": "{{pack}}/adapter.go",
      "stdout_unix.go": "{{pack}}/stdout_unix.go",
      "stdout_windows.go": "{{pack}}/stdout_windows.go"
    },
    "src_as": "{{src_name}}",
    "write": {
      "ctor.go": "package main\nfunc NewTarget() any { return New{{class}}() }\n",
      "go.mod": "module honepadrun\n\ngo 1.22\n"
    },
    "steps": [
      {
        "tool": [
          "go"
        ],
        "argv": [
          "{{tool}}",
          "build",
          "-o",
          "run",
          "."
        ],
        "fail": "go compile failed"
      }
    ],
    "argv": [
      "{{tmp}}/run",
      "{{cases}}",
      "{{report}}"
    ],
    "requires": [
      "go"
    ]
  }
}
